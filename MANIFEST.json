{
  "toolkit_name": "agent-wiki-toolkit",
  "distribution_version": "3.2-adaptive-production",
  "protocol_version": 3,
  "router_version": 2,
  "recommended_entry": "MANIFEST.json",
  "token_policy": "fetch MANIFEST.json first; choose ROUTER or ADAPTIVE_INTAKE; fetch only selected files; do not fetch core/PRINCIPLES_MAX.md unless selected",
  "machine_logic": {
    "entry_mode": [
      "questionnaire",
      "file_driven"
    ],
    "bootstrap_mode": [
      "new_project",
      "existing_agent_wiki",
      "recovery_needed"
    ],
    "bootstrap_tier": [
      "LITE",
      "MAX"
    ],
    "daily_loop_file": "core/PRINCIPLES_MINI.md",
    "role_mode": [
      "SOLO",
      "DUAL",
      "FULL"
    ]
  },
  "entry_rules": {
    "description_only": {
      "fetch": [
        "USER_PROFILE.md",
        "intake/ROUTER.md",
        "schemas/ROUTER_OUTPUT_SCHEMA.json"
      ]
    },
    "files_repo_archive_or_uploads": {
      "fetch": [
        "USER_PROFILE.md",
        "intake/ADAPTIVE_INTAKE.md",
        "schemas/SOURCE_INVENTORY_SCHEMA.json"
      ]
    },
    "manual_chat_handoff": {
      "fetch": [
        "scenarios/MANUAL_CHAT_HANDOFF.md"
      ]
    },
    "simple_api": {
      "fetch": [
        "scenarios/API_SIMPLE_FLOW.md"
      ]
    },
    "orchestrated_api": {
      "fetch": [
        "scenarios/API_ORCHESTRATED_FLOW.md"
      ]
    }
  },
  "selection_rules": {
    "new_low_risk_project": [
      "core/LITE.md"
    ],
    "new_high_risk_or_heavy_project": [
      "core/PRINCIPLES_MAX.md"
    ],
    "existing_agent_wiki_daily_loop": [
      "core/PRINCIPLES_MINI.md"
    ],
    "recovery_needed": [
      "core/PRINCIPLES_MAX.md"
    ],
    "book_legacy_project_only": [
      "project_notes/BOOK_PROJECT_NOTES.md"
    ]
  },
